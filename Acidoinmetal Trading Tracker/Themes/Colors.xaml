<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Fondo -->
    <SolidColorBrush x:Key="BgPrimary" Color="#0D1117"/>
    <SolidColorBrush x:Key="BgSecondary" Color="#161B22"/>
    <SolidColorBrush x:Key="BgCard" Color="#1C2128"/>
    <SolidColorBrush x:Key="BgSidebar" Color="#0A0C10"/>
    <SolidColorBrush x:Key="BgHover" Color="#21262D"/>

    <!-- Bordes -->
    <SolidColorBrush x:Key="BorderColor" Color="#30363D"/>

    <!-- Texto -->
    <SolidColorBrush x:Key="TextPrimary" Color="#E6EDF3"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#8B949E"/>

    <!-- Estados de trading -->
    <SolidColorBrush x:Key="ProfitGreen" Color="#3FB950"/>
    <SolidColorBrush x:Key="LossRed" Color="#F85149"/>
    <SolidColorBrush x:Key="WarningYellow" Color="#D29922"/>

    <!-- Acento -->
    <SolidColorBrush x:Key="AccentBlue" Color="#58A6FF"/>
    <SolidColorBrush x:Key="AccentHover" Color="#1F6FEB"/>

</ResourceDictionary>