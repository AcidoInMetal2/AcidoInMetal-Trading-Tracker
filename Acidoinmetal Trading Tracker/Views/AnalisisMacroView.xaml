<UserControl x:Class="Acidoinmetal_Trading_Tracker.Views.AnalisisMacroView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1100"
             Background="{StaticResource BgPrimary}">

    <Grid Margin="0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===================== COLUMNA EURO ===================== -->
        <Border Grid.Column="0"
                Background="{StaticResource BgCard}"
                BorderBrush="{StaticResource BorderColor}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="20">
            <StackPanel>
                <TextBlock Text="EURO"
                           FontSize="32"
                           FontWeight="Bold"
                           Foreground="{StaticResource AccentBlue}"/>
                <TextBlock Text="(EUR/USD)"
                           FontSize="16"
                           Foreground="{StaticResource TextSecondary}"
                           Margin="0,2,0,20"/>

                <TextBlock Text="Análisis Macro:"
                           FontSize="14" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimary}"
                           Margin="0,0,0,10"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Marco temporal -->
                    <StackPanel Grid.Column="0" Margin="0,0,15,0" VerticalAlignment="Top">
                        <TextBlock Text="Marco" FontSize="11"
                                   Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4"/>
                        <ComboBox Width="90"
                                  ItemsSource="{Binding EurH1.OpcionesMarco}"
                                  SelectedItem="{Binding EurH1.Macroview1}"/>
                    </StackPanel>

                    <!-- Preview de la imagen + campo de link -->
                    <StackPanel Grid.Column="1">
                        <Border Height="150"
                                Background="{StaticResource BgPrimary}"
                                BorderBrush="{StaticResource BorderColor}"
                                BorderThickness="1" CornerRadius="4"
                                Margin="0,0,0,6">
                            <Button Command="{Binding EurH1.AbrirImagenCommand}"
                                    Background="Transparent" BorderThickness="0" Padding="0"
                                    Cursor="Hand"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Button.Template>
                                <Grid>
                                    <Image Source="{Binding EurH1.ImagenPreview}" Stretch="Uniform" Margin="4"/>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10">
                                        <TextBlock Text="{Binding EurH1.Estado}"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   FontSize="11" TextWrapping="Wrap" TextAlignment="Center"/>
                                        <Button Content="🔄 Reintentar"
                                                Command="{Binding EurH1.ReintentarCommand}"
                                                HorizontalAlignment="Center" Margin="0,8,0,0" Padding="8,3">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding EurH1.MostrarReintentar}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </Border>
                        <TextBlock Text="Link" FontSize="11"
                                   Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding EurH1.Link, UpdateSourceTrigger=LostFocus}"
                                 Padding="6,5"/>
                    </StackPanel>
                </Grid>

                <!-- Rango Operativo (1-2 / 2-3 / 3-4, seleccion excluyente) -->
                <TextBlock Text="Rango Operativo" FontSize="11"
                           Foreground="{StaticResource TextSecondary}" Margin="0,15,0,4"/>
                <StackPanel Orientation="Horizontal">
                    <CheckBox Content="1-2" IsChecked="{Binding EurH1.Rango12}"
                              Foreground="{StaticResource TextPrimary}" Margin="0,0,20,0"/>
                    <CheckBox Content="2-3" IsChecked="{Binding EurH1.Rango23}"
                              Foreground="{StaticResource TextPrimary}" Margin="0,0,20,0"/>
                    <CheckBox Content="3-4" IsChecked="{Binding EurH1.Rango34}"
                              Foreground="{StaticResource TextPrimary}"/>
                </StackPanel>

                <!-- Estado del Rango + Dirección, mismo renglón -->
                <Grid Margin="0,15,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Estado del Rango" FontSize="11"
                                   Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding EurH1.OpcionesEstadoRango}"
                                  SelectedItem="{Binding EurH1.EstadoRango}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Dirección" FontSize="11"
                                   Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding EurH1.OpcionesDireccion}"
                                  SelectedItem="{Binding EurH1.Direccion}"/>
                    </StackPanel>
                </Grid>

                <!-- Comentarios -->
                <TextBlock Text="Comentarios" FontSize="11"
                           Foreground="{StaticResource TextSecondary}" Margin="0,15,0,4"/>
                <TextBox Text="{Binding EurH1.Comentarios, UpdateSourceTrigger=LostFocus}"
                         AcceptsReturn="True" TextWrapping="Wrap"
                         Height="70" Padding="6,5"
                         VerticalScrollBarVisibility="Auto"/>

            </StackPanel>
        </Border>

        <!-- ===================== COLUMNA LIBRA ===================== -->
        <Border Grid.Column="2"
                Background="{StaticResource BgCard}"
                BorderBrush="{StaticResource BorderColor}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="20">
            <StackPanel>
                <TextBlock Text="LIBRA"
                           FontSize="32"
                           FontWeight="Bold"
                           Foreground="{StaticResource AccentBlue}"/>
                <TextBlock Text="(GBP/USD)"
                           FontSize="16"
                           Foreground="{StaticResource TextSecondary}"
                           Margin="0,2,0,20"/>

                <TextBlock Text="Análisis Macro:"
                           FontSize="14" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimary}"
                           Margin="0,0,0,10"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Marco temporal -->
                    <StackPanel Grid.Column="0" Margin="0,0,15,0" VerticalAlignment="Top">
                        <TextBlock Text="Marco" FontSize="11"
                                   Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4"/>
                        <ComboBox Width="90"
                                  ItemsSource="{Binding GbpH1.OpcionesMarco}"
                                  SelectedItem="{Binding GbpH1.Macroview1}"/>
                    </StackPanel>

                    <!-- Preview de la imagen + campo de link -->
                    <StackPanel Grid.Column="1">
                        <Border Height="150"
                                Background="{StaticResource BgPrimary}"
                                BorderBrush="{StaticResource BorderColor}"
                                BorderThickness="1" CornerRadius="4"
                                Margin="0,0,0,6">
                            <Button Command="{Binding GbpH1.AbrirImagenCommand}"
                                    Background="Transparent" BorderThickness="0" Padding="0"
                                    Cursor="Hand"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Button.Template>
                                <Grid>
                                    <Image Source="{Binding GbpH1.ImagenPreview}" Stretch="Uniform" Margin="4"/>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10">
                                        <TextBlock Text="{Binding GbpH1.Estado}"
                                                   Foreground="{StaticResource TextSecondary}"
                                                   FontSize="11" TextWrapping="Wrap" TextAlignment="Center"/>
                                        <Button Content="🔄 Reintentar"
                                                Command="{Binding GbpH1.ReintentarCommand}"
                                                HorizontalAlignment="Center" Margin="0,8,0,0" Padding="8,3">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding GbpH1.MostrarReintentar}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </Border>
                        <TextBlock Text="Link" FontSize="11"
                                   Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding GbpH1.Link, UpdateSourceTrigger=LostFocus}"
                                 Padding="6,5"/>
                    </StackPanel>
                </Grid>

                <!-- Rango Operativo (1-2 / 2-3 / 3-4, seleccion excluyente) -->
                <TextBlock Text="Rango Operativo" FontSize="11"
                           Foreground="{StaticResource TextSecondary}" Margin="0,15,0,4"/>
                <StackPanel Orientation="Horizontal">
                    <CheckBox Content="1-2" IsChecked="{Binding GbpH1.Rango12}"
                              Foreground="{StaticResource TextPrimary}" Margin="0,0,20,0"/>
                    <CheckBox Content="2-3" IsChecked="{Binding GbpH1.Rango23}"
                              Foreground="{StaticResource TextPrimary}" Margin="0,0,20,0"/>
                    <CheckBox Content="3-4" IsChecked="{Binding GbpH1.Rango34}"
                              Foreground="{StaticResource TextPrimary}"/>
                </StackPanel>

                <!-- Estado del Rango + Dirección, mismo renglón -->
                <Grid Margin="0,15,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Estado del Rango" FontSize="11"
                                   Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding GbpH1.OpcionesEstadoRango}"
                                  SelectedItem="{Binding GbpH1.EstadoRango}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Dirección" FontSize="11"
                                   Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding GbpH1.OpcionesDireccion}"
                                  SelectedItem="{Binding GbpH1.Direccion}"/>
                    </StackPanel>
                </Grid>

                <!-- Comentarios -->
                <TextBlock Text="Comentarios" FontSize="11"
                           Foreground="{StaticResource TextSecondary}" Margin="0,15,0,4"/>
                <TextBox Text="{Binding GbpH1.Comentarios, UpdateSourceTrigger=LostFocus}"
                         AcceptsReturn="True" TextWrapping="Wrap"
                         Height="70" Padding="6,5"
                         VerticalScrollBarVisibility="Auto"/>

            </StackPanel>
        </Border>
    </Grid>
</UserControl>
