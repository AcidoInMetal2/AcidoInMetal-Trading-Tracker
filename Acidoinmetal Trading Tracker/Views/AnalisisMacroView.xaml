<UserControl x:Class="Acidoinmetal_Trading_Tracker.Views.AnalisisMacroView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1100"
             Background="{StaticResource BgPrimary}">

    <Grid Margin="0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===================== COLUMNA EURO ===================== -->
        <Border Grid.Column="0"
                Background="{StaticResource BgCard}"
                BorderBrush="{StaticResource BorderColor}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="20">
            <StackPanel>
                <TextBlock Text="EURO"
                           FontSize="32"
                           FontWeight="Bold"
                           Foreground="{StaticResource AccentBlue}"/>
                <TextBlock Text="(EUR/USD)"
                           FontSize="16"
                           Foreground="{StaticResource TextSecondary}"
                           Margin="0,2,0,20"/>

                <!-- Acá van los campos de carga del análisis del Euro -->

            </StackPanel>
        </Border>

        <!-- ===================== COLUMNA LIBRA ===================== -->
        <Border Grid.Column="2"
                Background="{StaticResource BgCard}"
                BorderBrush="{StaticResource BorderColor}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="20">
            <StackPanel>
                <TextBlock Text="LIBRA"
                           FontSize="32"
                           FontWeight="Bold"
                           Foreground="{StaticResource AccentBlue}"/>
                <TextBlock Text="(GBP/USD)"
                           FontSize="16"
                           Foreground="{StaticResource TextSecondary}"
                           Margin="0,2,0,20"/>

                <!-- Acá van los campos de carga del análisis de la Libra -->

            </StackPanel>
        </Border>
    </Grid>
</UserControl>
