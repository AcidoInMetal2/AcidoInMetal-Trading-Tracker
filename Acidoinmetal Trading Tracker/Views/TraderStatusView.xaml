<UserControl x:Class="Acidoinmetal_Trading_Tracker.Views.TraderStatusView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="400" Width="700">

    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="220" />
        </Grid.ColumnDefinitions>

        <!-- Tarjeta de métricas -->
        <Border Grid.Column="0" Background="#1A1A1A" CornerRadius="12" Padding="20" Margin="0,0,16,0">
            <StackPanel>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Descanso" Foreground="White" FontSize="14" VerticalAlignment="Center" />
                    <ItemsControl Grid.Column="1" ItemsSource="{Binding EstrellasDescanso}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ToggleButton Style="{StaticResource EstrellaStyle}"
                                              IsChecked="{Binding Marcada, Mode=OneWay}"
                                              Command="{Binding DataContext.SeleccionarDescansoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              CommandParameter="{Binding Numero}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>

                <Separator Margin="0,4" />

                <Grid Margin="0,8,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Estado anímico" Foreground="White" FontSize="14" VerticalAlignment="Center" />
                    <ItemsControl Grid.Column="1" ItemsSource="{Binding EstrellasEstadoAnimico}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ToggleButton Style="{StaticResource EstrellaStyle}"
                                              IsChecked="{Binding Marcada, Mode=OneWay}"
                                              Command="{Binding DataContext.SeleccionarEstadoAnimicoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              CommandParameter="{Binding Numero}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>

                <Separator Margin="0,4" />

                <Grid Margin="0,8,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Nivel de stress" Foreground="White" FontSize="14" VerticalAlignment="Center" />
                    <ItemsControl Grid.Column="1" ItemsSource="{Binding EstrellasNivelStress}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ToggleButton Style="{StaticResource EstrellaStyle}"
                                              IsChecked="{Binding Marcada, Mode=OneWay}"
                                              Command="{Binding DataContext.SeleccionarNivelStressCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              CommandParameter="{Binding Numero}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>

                <Separator Margin="0,4" />

                <Grid Margin="0,8,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Nivel de ansiedad" Foreground="White" FontSize="14" VerticalAlignment="Center" />
                    <ItemsControl Grid.Column="1" ItemsSource="{Binding EstrellasNivelAnsiedad}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ToggleButton Style="{StaticResource EstrellaStyle}"
                                              IsChecked="{Binding Marcada, Mode=OneWay}"
                                              Command="{Binding DataContext.SeleccionarNivelAnsiedadCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              CommandParameter="{Binding Numero}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>

                <Separator Margin="0,4" />

                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Cabina estéril" Foreground="White" FontSize="14" VerticalAlignment="Center" />
                    <ItemsControl Grid.Column="1" ItemsSource="{Binding EstrellasCabinaEsteril}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ToggleButton Style="{StaticResource EstrellaStyle}"
                                              IsChecked="{Binding Marcada, Mode=OneWay}"
                                              Command="{Binding DataContext.SeleccionarCabinaEsterilCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              CommandParameter="{Binding Numero}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>

            </StackPanel>
        </Border>

        <!-- Círculo de estado -->
        <StackPanel Grid.Column="1" VerticalAlignment="Top">
            <Border Background="#1A1A1A" CornerRadius="12" Padding="20" Margin="0,0,0,12">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="Estado de trader" Foreground="#AAAAAA" FontSize="13" HorizontalAlignment="Center" Margin="0,0,0,12" />
                    <Grid Width="140" Height="140">
                        <Ellipse Stroke="#3A3A3A" StrokeThickness="10" />
                        <TextBlock Text="{Binding Porcentaje, StringFormat={}{0}%}"
                                   FontSize="26" FontWeight="Medium"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{Binding ColorEstadoBrush}" />
                    </Grid>
                </StackPanel>
            </Border>

            <Button Content="{Binding EtiquetaBoton}" Command="{Binding ConfirmarCommand}" Padding="0,10" />
        </StackPanel>

    </Grid>
</UserControl>
